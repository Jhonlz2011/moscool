---
const steps = [
  {
    num: "01",
    title: "Pre-Diagnóstico y Agendamiento",
    desc: "Envías los datos de tu equipo a través de nuestro simulador web o WhatsApp. Asignamos la cuadrilla especializada más cercana a tu sector.",
    badge: "15 min de respuesta",
  },
  {
    num: "02",
    title: "Inspección In-Situ con Instrumental",
    desc: "El técnico calificado evalúa presiones, estanqueidad, señales lógicas y consumo eléctrico en Amperes con instrumental digital calibrado.",
    badge: "Diagnóstico exacto",
  },
  {
    num: "03",
    title: "Emisión de Proforma en PDF",
    desc: "Antes de desarmar o instalar piezas, recibes en tu celular el documento formal con el desglose exacto de repuestos y mano de obra.",
    badge: "Cero sorpresas",
  },
  {
    num: "04",
    title: "Reparación y Certificado de Garantía",
    desc: "Ejecutamos el trabajo con repuestos homologados, realizamos pruebas de rendimiento y emitimos tu garantía certificada por escrito.",
    badge: "30 a 90 días respaldo",
  },
];
---

<section class="py-24 bg-[#090D16]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-medium bg-sky-500/10 text-sky-400 border border-sky-500/20 mb-3">
        PROTOCOLO DE ATENCIÓN
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        4 Fases Transparentes: <span class="text-gradient-cyan">Cómo Trabajamos</span>
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2">
        Un proceso estructurado para que tengas el control absoluto del estado de tu electrodoméstico y de tu presupuesto.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((s) => (
        <div class="rounded-2xl bg-slate-900/80 border border-slate-800 p-6 flex flex-col justify-between glass-panel-hover relative">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-800/80 mb-4">
              <span class="font-mono text-2xl font-black text-sky-400">{s.num}</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-500/15 text-sky-300 border border-sky-500/30">
                {s.badge}
              </span>
            </div>
            <h3 class="text-base font-bold text-white mb-2 tracking-tight">
              {s.title}
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              {s.desc}
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-800/50 flex items-center gap-2 text-[11px] font-mono text-emerald-400">
            <span>✓</span> Protocolo Verificado
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
