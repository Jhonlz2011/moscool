---
import { siteConfig } from "../../data/siteConfig";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden bg-tech-grid">
  {/* Radial Ambient Glows */}
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-sky-600/15 rounded-full blur-[140px] pointer-events-none"></div>
  <div class="absolute top-1/3 -right-20 w-[400px] h-[300px] bg-blue-700/10 rounded-full blur-[120px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      {/* Left Column: Headline and Actions */}
      <div class="lg:col-span-7 space-y-6">
        {/* Verification Tag */}
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/80 text-xs font-mono shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          <span class="text-slate-300 font-semibold">TALLER ESPECIALIZADO</span>
          <span class="text-slate-600">•</span>
          <span class="text-sky-400">PROFORMAS PDF AL INSTANTE</span>
        </div>

        {/* Main H1 Title */}
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.08]">
          Climatización y Línea Blanca con <span class="text-gradient-cyan">Precisión Técnica</span>
        </h1>

        {/* Subtitle */}
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          Mantenimiento profundo, recargas de gas con bomba de vacío y reparación de tarjetas electrónicas Inverter para Aires Acondicionados, Neveras, Lavadoras y Cocinas. <strong>Inspección transparente in-situ y emisión inmediata de tu proforma formal en PDF</strong> con la aplicación oficial Moscool.
        </p>

        {/* Dual Actions */}
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a
            href="#diagnostico"
            class="px-6 py-4 rounded-xl bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white font-bold text-sm tracking-wide shadow-xl shadow-sky-600/25 transition-all text-center flex items-center justify-center gap-2 group"
          >
            <span>Calcular Diagnóstico Online</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M19 9l-7 7-7-7"/>
            </svg>
          </a>

          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-4 rounded-xl bg-slate-900/80 hover:bg-slate-800 border border-slate-700 hover:border-slate-600 text-white font-semibold text-sm transition-all text-center flex items-center justify-center gap-2"
          >
            <svg class="w-4 h-4 text-emerald-400 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Despacho por WhatsApp</span>
          </a>
        </div>

        {/* Technical Trust Badges */}
        <div class="pt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-800/80 text-xs font-mono">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>30 a 90 Días Garantía</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-sky-400 font-bold">✓</span>
            <span>Vacuómetro Calibrado</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-amber-400 font-bold">✓</span>
            <span>Repuestos Homologados</span>
          </div>
        </div>
      </div>

      {/* Right Column: Industrial Telemetry & Proforma Card */}
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl bg-slate-900/90 border border-slate-700/80 p-6 shadow-2xl backdrop-blur-xl">
          {/* Card Top Header */}
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center gap-2.5">
              <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
              <span class="text-xs font-mono font-bold tracking-wider text-slate-300 uppercase">
                MONITOR TÉCNICO DE CAMPO
              </span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-sky-500/20 text-sky-300 border border-sky-500/30 font-semibold">
              R410A / R32 OK
            </span>
          </div>

          {/* 3 Telemetry Indicators Grid */}
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block mb-1">Presión Succión</span>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-bold font-mono text-white">125</span>
                <span class="text-xs font-mono text-sky-400 font-medium">PSI</span>
              </div>
              <span class="text-[10px] font-mono text-emerald-400 mt-1 block">Rango de Trabajo Normal</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block mb-1">Vacío de Humedad</span>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-bold font-mono text-white">380</span>
                <span class="text-xs font-mono text-sky-400 font-medium">Micrones</span>
              </div>
              <span class="text-[10px] font-mono text-emerald-400 mt-1 block">Estanqueidad Certificada</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block mb-1">Salto Térmico (ΔT)</span>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-bold font-mono text-white">14.8</span>
                <span class="text-xs font-mono text-sky-400 font-medium">°C</span>
              </div>
              <span class="text-[10px] font-mono text-emerald-400 mt-1 block">Rendimiento Frigorífico</span>
            </div>

            <div class="p-3.5 rounded-xl bg-slate-950/70 border border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block mb-1">Corriente (RLA)</span>
              <div class="flex items-baseline gap-1">
                <span class="text-xl font-bold font-mono text-white">5.2</span>
                <span class="text-xs font-mono text-sky-400 font-medium">Amperes</span>
              </div>
              <span class="text-[10px] font-mono text-emerald-400 mt-1 block">Consumo Nominal</span>
            </div>
          </div>

          {/* Integrated Proforma Mini Sample */}
          <div class="mt-4 p-4 rounded-xl bg-slate-950/90 border border-slate-800 font-mono text-xs">
            <div class="flex items-center justify-between pb-2 border-b border-slate-900">
              <span class="text-sky-400 font-bold text-[11px]">PROFORMA DIGITAL #STM-0842</span>
              <span class="text-[10px] text-slate-500">FORMATO PDF OFICIAL</span>
            </div>
            <div class="space-y-1.5 mt-2.5 text-[11px]">
              <div class="flex justify-between text-slate-300">
                <span>Servicio:</span>
                <span class="font-medium text-white">Mantenimiento + Recarga R410A</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Equipo:</span>
                <span class="font-medium text-white">Split Inverter 18,000 BTU</span>
              </div>
              <div class="flex justify-between text-slate-300">
                <span>Garantía:</span>
                <span class="font-semibold text-emerald-400">60 Días Certificada</span>
              </div>
            </div>
          </div>

          {/* Footer note */}
          <div class="mt-4 flex items-center justify-between text-[11px] font-mono text-slate-400">
            <span>Inspector: Cuadrilla Central Moscool</span>
            <span class="text-sky-400 font-semibold">Trazabilidad Total</span>
          </div>
        </div>

        {/* Floating Accent Badge */}
        <div class="absolute -bottom-4 -left-4 bg-slate-900 border border-sky-500/40 rounded-xl px-4 py-2.5 shadow-xl flex items-center gap-2.5 font-mono text-xs">
          <img src="/brand/logo.png" alt="Icono Moscool" class="w-6 h-6 object-contain" width="24" height="24" />
          <span class="text-slate-200 font-bold">App Móvil de Taller Integrada</span>
        </div>
      </div>

    </div>
  </div>
</section>
