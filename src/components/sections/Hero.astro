---
import { siteConfig } from "../../data/siteConfig";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";
import PhoneIcon from "../ui/icons/PhoneIcon.astro";
import CheckIcon from "../ui/icons/CheckIcon.astro";
import ShieldCheckIcon from "../ui/icons/ShieldCheckIcon.astro";
import ClockFastIcon from "../ui/icons/ClockFastIcon.astro";
import HomeShieldIcon from "../ui/icons/HomeShieldIcon.astro";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-grid-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Headline and Call to Action -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-xs text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Atención a Domicilio • Guayaquil, Samborondón y Durán</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          ¿Tu Aire Acondicionado o Nevera Dejó de Enfriar?
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          {siteConfig.tagline}. Solucionamos averías urgentes con <strong>diagnóstico honesto</strong>, respeto por tu hogar y <strong>30 días de garantía por escrito</strong>. Recibes presupuesto claro antes de iniciar cualquier reparación.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-colors text-center flex items-center justify-center gap-2.5 shadow-lg shadow-emerald-950/40"
          >
            <WhatsAppIcon class="w-4 h-4 fill-current" />
            <span>Agendar Visita por WhatsApp</span>
          </a>

          <a
            href={`tel:${siteConfig.phone.replace(/\s+/g, '')}`}
            class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 hover:text-white font-semibold text-sm transition-colors text-center flex items-center justify-center gap-2"
          >
            <PhoneIcon class="w-4 h-4 text-sky-400" />
            <span>Llamar al Técnico ({siteConfig.phoneFormatted})</span>
          </a>
        </div>

        <!-- 3 Pillars with Pure SVG Icons -->
        <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-800 text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <ClockFastIcon class="w-4 h-4 text-amber-400 shrink-0" />
            <span>Atención Rápida (1-2h)</span>
          </div>
          <div class="flex items-center gap-2">
            <HomeShieldIcon class="w-4 h-4 text-sky-400 shrink-0" />
            <span>Cuidado de Paredes y Pisos</span>
          </div>
          <div class="flex items-center gap-2">
            <ShieldCheckIcon class="w-4 h-4 text-emerald-400 shrink-0" />
            <span>30 Días de Garantía</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Home Service Guarantee Card -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-6 shadow-2xl space-y-4 max-w-md mx-auto">
          <!-- Top Card Brand -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-white p-1 flex items-center justify-center shrink-0">
                <img src="/brand/logo.png" alt="Logo" class="w-full h-full object-contain" width="40" height="40" />
              </div>
              <div>
                <span class="font-bold text-sm text-white block leading-tight">{siteConfig.name}</span>
                <span class="text-[11px] text-slate-400">Servicio Técnico a Domicilio</span>
              </div>
            </div>
            <span class="text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
              Garantía Formal
            </span>
          </div>

          <!-- Key Service Commitments -->
          <div class="space-y-3 text-xs">
            <div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-slate-950 border border-slate-800/80">
              <CheckIcon class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <div>
                <span class="font-semibold text-white block">Presupuesto Previo sin Sorpresas</span>
                <p class="text-slate-400 text-[11px] mt-0.5">
                  Conoces el valor exacto de mano de obra y repuestos antes de iniciar.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-slate-950 border border-slate-800/80">
              <CheckIcon class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <div>
                <span class="font-semibold text-white block">Protección de tu Espacio</span>
                <p class="text-slate-400 text-[11px] mt-0.5">
                  Fundas especiales colectoras al lavar splits para no humedecer tus paredes.
                </p>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-2.5 rounded-lg bg-slate-950 border border-slate-800/80">
              <CheckIcon class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
              <div>
                <span class="font-semibold text-white block">Repuestos Nuevos con Respaldo</span>
                <p class="text-slate-400 text-[11px] mt-0.5">
                  Componentes originales o certificados específicos para tu marca.
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom Action -->
          <div class="pt-2">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent("Hola, deseo solicitar una visita técnica para mi domicilio.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-sky-600 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2"
            >
              <WhatsAppIcon class="w-4 h-4 fill-current" />
              <span>Coordinar Visita en tu Sector</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
