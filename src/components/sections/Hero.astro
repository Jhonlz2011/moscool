---
import { siteConfig } from "../../data/siteConfig";
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-grid-subtle">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Headline and Call to Action -->
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-xs text-slate-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>Atención a Domicilio • Guayaquil, Samborondón y Durán</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Servicio Técnico Especializado en Climatización y Línea Blanca
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl font-normal">
          {siteConfig.tagline}. Evaluamos tu equipo en tu domicilio, emitimos tu <strong>proforma digital en PDF</strong> con el desglose exacto de repuestos y mano de obra, y te entregamos <strong>30 días de garantía por escrito</strong>.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-2">
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-colors text-center flex items-center justify-center gap-2 shadow-lg shadow-emerald-950/40"
          >
            <span>Consultar por WhatsApp</span>
          </a>

          <a
            href="#diagnostico"
            class="px-6 py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 hover:text-white font-semibold text-sm transition-colors text-center"
          >
            <span>Simulador de Diagnóstico</span>
          </a>
        </div>

        <!-- 3 Pillars -->
        <div class="pt-6 grid grid-cols-1 sm:grid-cols-3 gap-3 border-t border-slate-800 text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">✓</span>
            <span>30 Días de Garantía</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-sky-400 font-bold">✓</span>
            <span>Proforma Digital en PDF</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-amber-400 font-bold">✓</span>
            <span>Atención a Domicilio</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Proforma PDF Mockup (Faithful to mobile app) -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl bg-white text-slate-900 p-6 shadow-2xl border border-slate-200 font-sans text-xs max-w-md mx-auto">
          <!-- Document Header -->
          <div class="flex items-start justify-between pb-4 border-b border-slate-200">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-lg bg-slate-900 p-1 flex items-center justify-center shrink-0">
                <img src="/brand/logo.png" alt="Logo" class="w-full h-full object-contain" width="40" height="40" />
              </div>
              <div>
                <h2 class="font-bold text-sm text-slate-900 leading-tight">
                  {siteConfig.name}
                </h2>
                <p class="text-[10px] text-sky-700 font-semibold uppercase tracking-tight mt-0.5">
                  Reparación • Mantenimiento • Instalación
                </p>
                <p class="text-[10px] text-slate-500">
                  Tel: {siteConfig.phoneFormatted}
                </p>
              </div>
            </div>
            <div class="text-right">
              <span class="text-[10px] font-bold text-sky-700 block uppercase">Proforma</span>
              <span class="text-xs font-mono font-bold text-slate-800">#PROF-0142</span>
            </div>
          </div>

          <!-- Customer & Equipment Info -->
          <div class="grid grid-cols-2 gap-3 py-3 border-b border-slate-100 text-[11px]">
            <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-[10px] font-bold text-slate-500 block uppercase">Atención</span>
              <span class="font-semibold text-slate-800 block">Cliente Residencial</span>
              <span class="text-slate-600 text-[10px] block">Samborondón, Guayas</span>
            </div>
            <div class="bg-slate-50 p-2.5 rounded-lg border border-slate-100">
              <span class="text-[10px] font-bold text-slate-500 block uppercase">Equipo</span>
              <span class="font-semibold text-slate-800 block">Aire Split Inverter</span>
              <span class="text-slate-600 text-[10px] block">Capacidad 18,000 BTU</span>
            </div>
          </div>

          <!-- Table of items -->
          <div class="py-3">
            <span class="text-[10px] font-bold text-slate-500 block uppercase mb-2">Detalle de Servicios y Repuestos</span>
            <div class="space-y-1.5 text-[11px]">
              <div class="flex justify-between py-1 border-b border-slate-100">
                <span class="text-slate-700">1x Mantenimiento preventivo profundo</span>
                <span class="font-semibold text-slate-900">$35.00</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-100">
                <span class="text-slate-700">1x Corrección de fuga y recarga de gas</span>
                <span class="font-semibold text-slate-900">$30.00</span>
              </div>
              <div class="flex justify-between py-1 border-b border-slate-100">
                <span class="text-slate-700">1x Limpieza de canalización de drenaje</span>
                <span class="font-semibold text-slate-900">$10.00</span>
              </div>
            </div>
          </div>

          <!-- Total -->
          <div class="bg-slate-900 text-white p-3 rounded-lg flex items-center justify-between text-xs mt-2">
            <span class="font-semibold">TOTAL PROFORMA:</span>
            <span class="font-bold text-base text-white">$75.00 USD</span>
          </div>

          <!-- Guarantee note -->
          <div class="mt-3 text-[10px] text-slate-500 bg-slate-50 p-2 rounded border border-slate-100">
            <strong>Garantía:</strong> 30 días de garantía en mano de obra y repuestos instalados. Válida por 15 días.
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
