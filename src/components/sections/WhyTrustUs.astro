---
import HomeShieldIcon from "../ui/icons/HomeShieldIcon.astro";
import ShieldCheckIcon from "../ui/icons/ShieldCheckIcon.astro";
import ClockFastIcon from "../ui/icons/ClockFastIcon.astro";
import WrenchToolIcon from "../ui/icons/WrenchToolIcon.astro";
import CheckIcon from "../ui/icons/CheckIcon.astro";
import BeforeAfterSlider from "../islands/BeforeAfterSlider";

const trustPillars = [
  {
    title: "Cuidado de tus Paredes y Pisos",
    description: "Al lavar splits instalamos fundas herméticas con desagüe a balde. El agua sucia y químicos nunca tocan tus paredes de yeso, molduras ni pisos.",
    icon: HomeShieldIcon,
    tag: "Funda colectora sellada",
  },
  {
    title: "Diagnóstico Honesto y Verificable",
    description: "Si tu aire o nevera solo tiene un capacitor defectuoso o suciedad acumulada, te cobramos exactamente eso. No inventamos fugas de gas para inflar la cuenta.",
    icon: WrenchToolIcon,
    tag: "Medición en tu presencia",
  },
  {
    title: "Presupuesto Previo (Validez 15 Días)",
    description: "Evaluamos el equipo y emitimos un presupuesto formal con desglose exacto de repuestos y mano de obra antes de iniciar. Tienes 15 días de vigencia.",
    icon: ClockFastIcon,
    tag: "Sin cobros sorpresa",
  },
  {
    title: "Garantía de 30 Días por Escrito",
    description: "Cada intervención incluye respaldo formal por escrito. Si el componente reparado presenta novedades en ese periodo, acudimos a resolver sin costo adicional.",
    icon: ShieldCheckIcon,
    tag: "Comprobante formal físico",
  },
];
---

<section class="py-20 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800" id="confianza">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block mb-2 font-mono">
        Norma Residencial In-Situ
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Estándar Técnico Diseñado para Hogares de Samborondón y Guayaquil
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Sabemos que abrir la puerta de tu hogar a un técnico requiere seguridad en garita, limpieza absoluta y honestidad en el diagnóstico. Este es nuestro protocolo formal.
      </p>
    </div>

    <!-- 4-Pillar Integrated Architectural Panel -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden divide-y lg:divide-y-0 lg:divide-x divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900 shadow-xl mb-16">
      {trustPillars.map((tp, idx) => {
        const IconComponent = tp.icon;
        return (
          <div class="p-6 sm:p-7 flex flex-col justify-between hover:bg-slate-50/60 dark:hover:bg-slate-950/40">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <div class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center shrink-0">
                  <IconComponent class="w-4 h-4 text-sky-600 dark:text-sky-400" />
                </div>
                <span class="text-[10px] font-mono font-bold text-slate-400 dark:text-slate-500">
                  NORMA // 0{idx + 1}
                </span>
              </div>

              <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2 leading-snug">
                {tp.title}
              </h3>

              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {tp.description}
              </p>
            </div>

            <div class="pt-4 mt-6 border-t border-slate-100 dark:border-slate-800/80 flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 font-mono">
              <CheckIcon class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0" />
              <span class="font-semibold text-slate-700 dark:text-slate-300">{tp.tag}</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Before / After Interactive Visual Proof Module -->
    <div class="rounded-3xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/90 p-6 sm:p-10 shadow-xl">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
          Inspección Endoscópica In-Situ
        </span>
        <h3 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white">
          Diferencia Real: Turbina y Serpentín de Split
        </h3>
        <p class="text-slate-600 dark:text-slate-300 text-xs sm:text-sm mt-2">
          En el clima húmedo de Guayaquil, la turbina acumula moho negro que bloquea el flujo de aire y genera malos olores. Desliza la barra para ver el resultado de un lavado técnico con funda colectora sin manchar tus paredes.
        </p>
      </div>

      <BeforeAfterSlider
        client:visible
        beforeSrc="/assets/images/before-after/split-turbina-sucio.svg"
        afterSrc="/assets/images/before-after/split-turbina-limpio.svg"
        beforeAlt="Turbina de split con moho y suciedad antes del mantenimiento"
        afterAlt="Turbina de split desinfectada y limpia después del mantenimiento"
        beforeLabel="Antes: Con Moho"
        afterLabel="Después: Sanitizado"
      />
    </div>

  </div>
</section>
