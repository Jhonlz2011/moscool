---
import HomeShieldIcon from "../ui/icons/HomeShieldIcon.astro";
import ShieldCheckIcon from "../ui/icons/ShieldCheckIcon.astro";
import ClockFastIcon from "../ui/icons/ClockFastIcon.astro";
import WrenchToolIcon from "../ui/icons/WrenchToolIcon.astro";
import CheckIcon from "../ui/icons/CheckIcon.astro";

const trustPillars = [
  {
    title: "Cuidado de tus Paredes y Pisos",
    description: "Al realizar mantenimiento a splits instalamos fundas impermeables con colector cerrado. El agua sucia y químicos nunca tocan tus paredes de yeso, cortinas ni pisos.",
    icon: HomeShieldIcon,
  },
  {
    title: "Diagnóstico Honesto y Verificable",
    description: "Si tu aire o nevera solo tiene un capacitor defectuoso o suciedad acumulada, te cobramos exactamente eso. No inventamos 'fugas de gas' inexistentes para inflar la cuenta.",
    icon: WrenchToolIcon,
  },
  {
    title: "Coordinación Ágil para Garitas",
    description: "Proporcionamos nombre e identificación con anticipación para facilitar el ingreso vehicular en urbanizaciones cerradas de Samborondón, Ceibos y Vía a la Costa.",
    icon: ClockFastIcon,
  },
  {
    title: "Garantía de 30 Días por Escrito",
    description: "Cada intervención incluye respaldo formal por escrito. Si el equipo presenta novedades durante el periodo de garantía, acudimos a revisar sin cobros adicionales.",
    icon: ShieldCheckIcon,
  },
];
---

<section class="py-20 bg-slate-950 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-14">
      <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400 block mb-2">
        Confianza y Profesionalismo
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
        Por Qué los Hogares en Guayaquil y Samborondón Confían en Nosotros
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Sabemos que abrir la puerta de tu hogar a un técnico requiere seguridad, limpieza y honestidad. Nuestro estándar de servicio está diseñado para darte total tranquilidad.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {trustPillars.map((tp) => {
        const IconComponent = tp.icon;
        return (
          <div class="rounded-2xl bg-slate-900 border border-slate-800 p-6 flex flex-col justify-between hover:border-slate-700 transition-colors">
            <div>
              <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center mb-4">
                <IconComponent class="w-5 h-5 text-sky-400" />
              </div>

              <h3 class="text-base font-bold text-white mb-2 leading-snug">
                {tp.title}
              </h3>

              <p class="text-xs text-slate-300 leading-relaxed">
                {tp.description}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-800/80 flex items-center gap-1.5 text-xs text-emerald-400 font-semibold">
              <CheckIcon class="w-3.5 h-3.5 text-emerald-400" />
              <span>Compromiso Cumplido</span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
