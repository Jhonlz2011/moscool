---
import { servicesData } from "../../data/services";
import { siteConfig } from "../../data/siteConfig";
import SnowflakeIcon from "../ui/icons/SnowflakeIcon.astro";
import RefrigeratorIcon from "../ui/icons/RefrigeratorIcon.astro";
import WashingMachineIcon from "../ui/icons/WashingMachineIcon.astro";
import FlameIcon from "../ui/icons/FlameIcon.astro";
import CheckIcon from "../ui/icons/CheckIcon.astro";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";

const iconsMap: Record<string, any> = {
  climatizacion: SnowflakeIcon,
  refrigeracion: RefrigeratorIcon,
  "lavado-secado": WashingMachineIcon,
  "cocinas-hornos": FlameIcon,
};

const illustrationsMap: Record<string, string> = {
  climatizacion: "/assets/images/services/aire-condicionado.svg",
  refrigeracion: "/assets/images/services/refrigerador.svg",
  "lavado-secado": "/assets/images/services/lavadora.svg",
  "cocinas-hornos": "/assets/images/services/cocina.svg",
};

const refCodesMap: Record<string, string> = {
  climatizacion: "MOD-01 // CLIMATIZACIÓN RESIDENCIAL",
  refrigeracion: "MOD-02 // REFRIGERACIÓN NO-FROST & INVERTER",
  "lavado-secado": "MOD-03 // SISTEMAS DE LAVADO Y CENTRIFUGADO",
  "cocinas-hornos": "MOD-04 // SISTEMAS DE COCCIÓN Y HORNOS",
};
---

<section id="servicios" class="py-20 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Editorial Section Header -->
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-2 font-mono">
        Directorio Técnico de Especialidades
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Catálogo de Servicios Técnicos a Domicilio
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Intervenciones metódicas para las 4 líneas principales de electrodomésticos en Guayaquil, Samborondón y Durán. Diagnóstico en tu presencia, instrumental de calibración y 30 días de garantía por escrito.
      </p>
    </div>

    <!-- Continuous Architectural Directory Matrix -->
    <div class="border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden divide-y divide-slate-200 dark:divide-slate-800 bg-white dark:bg-slate-900 shadow-xl">
      {servicesData.map((service, index) => {
        const IconComponent = iconsMap[service.id] || SnowflakeIcon;
        const illustration = illustrationsMap[service.id];
        return (
          <div class="grid grid-cols-1 lg:grid-cols-12 hover:bg-slate-50/60 dark:hover:bg-slate-950/40">
            <!-- Left: Technical Vector Blueprint Frame (lg:col-span-4) -->
            <div class="lg:col-span-4 p-6 sm:p-8 bg-slate-50/70 dark:bg-slate-950/70 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800 flex flex-col justify-between">
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="text-[11px] font-mono font-bold text-sky-600 dark:text-sky-400">
                  {refCodesMap[service.id] || `MOD-0${index + 1}`}
                </span>
                <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-800">
                  {service.warrantyDays} Días Garantía
                </span>
              </div>

              {illustration && (
                <div class="aspect-[16/10] w-full flex items-center justify-center p-4 bg-white dark:bg-slate-900/60 rounded-xl border border-slate-200 dark:border-slate-800">
                  <img
                    src={illustration}
                    alt={service.title}
                    class="max-h-36 w-auto object-contain dark:invert"
                    loading="lazy"
                  />
                </div>
              )}

              <div class="pt-4 flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400">
                <IconComponent class="w-4 h-4 text-sky-600 dark:text-sky-400 shrink-0" />
                <span>Línea {service.category}</span>
              </div>
            </div>

            <!-- Right: Technical Scope, Interventions and Direct CTA (lg:col-span-8) -->
            <div class="lg:col-span-8 p-6 sm:p-8 flex flex-col justify-between">
              <div>
                <h3 class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white tracking-tight mb-2">
                  {service.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6 max-w-3xl">
                  {service.description}
                </p>

                <!-- Included Protocols Grid -->
                <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800 mb-6">
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 block mb-2.5">
                    Protocolo de Intervención en Domicilio:
                  </span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                    {service.included.map((item) => (
                      <div class="text-xs text-slate-700 dark:text-slate-300 flex items-start gap-2">
                        <CheckIcon class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Action Bar -->
              <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400">
                  Visitas coordinadas para Samborondón, Guayaquil y Durán
                </span>
                <a
                  href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hola Servicio Técnico Mendoza, requiero información y cotización para el servicio de: ${service.title}`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-semibold text-xs shrink-0 shadow-md shadow-emerald-950/20 active:translate-y-0.5 cursor-pointer"
                >
                  <WhatsAppIcon class="w-3.5 h-3.5 fill-current" />
                  <span>Consultar {service.category} por WhatsApp</span>
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
