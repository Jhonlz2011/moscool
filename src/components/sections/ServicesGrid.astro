---
import { servicesData } from "../../data/services";
import { siteConfig } from "../../data/siteConfig";
---

<section id="servicios" class="py-20 bg-slate-950 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-14">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Servicios Técnicos Especializados
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Atención técnica directa a domicilio en Guayaquil, Samborondón y Durán. Diagnóstico claro, repuestos de calidad y garantía formal.
      </p>
    </div>

    <!-- 4 Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {servicesData.map((service) => (
        <div class="rounded-2xl bg-slate-900 border border-slate-800 p-7 flex flex-col justify-between hover:border-slate-700 transition-colors">
          <div>
            <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
              <span class="text-xs font-semibold uppercase tracking-wider text-sky-400">
                {service.category}
              </span>
              <span class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                {service.warrantyDays} días de garantía
              </span>
            </div>

            <h3 class="text-lg font-bold text-white tracking-tight mb-2">
              {service.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
              {service.description}
            </p>

            <div class="space-y-2 mb-6">
              <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">
                Trabajos frecuentes:
              </span>
              <ul class="space-y-1.5">
                {service.included.map((item) => (
                  <li class="text-xs text-slate-300 flex items-start gap-2">
                    <span class="text-sky-400 font-bold">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-5 border-t border-slate-800">
            <a
              href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hola, requiero información y cotización para el servicio de: ${service.title}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2"
            >
              <span>Consultar este Servicio por WhatsApp</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
