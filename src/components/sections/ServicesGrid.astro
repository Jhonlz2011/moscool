---
import { servicesData } from "../../data/services";
import { siteConfig } from "../../data/siteConfig";
import SnowflakeIcon from "../ui/icons/SnowflakeIcon.astro";
import RefrigeratorIcon from "../ui/icons/RefrigeratorIcon.astro";
import WashingMachineIcon from "../ui/icons/WashingMachineIcon.astro";
import FlameIcon from "../ui/icons/FlameIcon.astro";
import CheckIcon from "../ui/icons/CheckIcon.astro";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";

const iconsMap: Record<string, any> = {
  climatizacion: SnowflakeIcon,
  refrigeracion: RefrigeratorIcon,
  "lavado-secado": WashingMachineIcon,
  "cocinas-hornos": FlameIcon,
};
---

<section id="servicios" class="py-20 bg-slate-950 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="max-w-3xl mb-14">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-400 block mb-2">
        Nuestras Especialidades
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight">
        Servicios Técnicos Especializados a Domicilio
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Soluciones integrales para las 4 líneas principales de electrodomésticos en Guayaquil, Samborondón y Durán. Diagnóstico claro, instrumental adecuado y 30 días de garantía.
      </p>
    </div>

    <!-- 4 Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {servicesData.map((service) => {
        const IconComponent = iconsMap[service.id] || SnowflakeIcon;
        return (
          <div class="rounded-2xl bg-slate-900 border border-slate-800 p-7 flex flex-col justify-between hover:border-slate-700 transition-colors">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-slate-800 mb-4">
                <div class="flex items-center gap-2.5">
                  <div class="w-8 h-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center">
                    <IconComponent class="w-4 h-4 text-sky-400" />
                  </div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">
                    {service.category}
                  </span>
                </div>
                <span class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/20">
                  {service.warrantyDays} días de garantía
                </span>
              </div>

              <h3 class="text-lg font-bold text-white tracking-tight mb-2">
                {service.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-5">
                {service.description}
              </p>

              <div class="space-y-2 mb-6">
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 block">
                  Trabajos frecuentes:
                </span>
                <ul class="space-y-1.5">
                  {service.included.map((item) => (
                    <li class="text-xs text-slate-300 flex items-start gap-2">
                      <CheckIcon class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-5 border-t border-slate-800">
              <a
                href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hola, requiero información y cotización para el servicio de: ${service.title}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-emerald-600 text-slate-200 hover:text-white font-semibold text-xs transition-colors flex items-center justify-center gap-2"
              >
                <WhatsAppIcon class="w-4 h-4 fill-current" />
                <span>Consultar este Servicio por WhatsApp</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
