---
const brands = [
  { name: "Samsung", logo: "/assets/brands/samsung.svg" },
  { name: "LG", logo: "/assets/brands/lg.svg" },
  { name: "Whirlpool", logo: "/assets/brands/whirlpool.svg" },
  { name: "Mabe", logo: "/assets/brands/mabe.svg" },
  { name: "Carrier", logo: "/assets/brands/carrier.svg" },
  { name: "Electrolux", logo: "/assets/brands/electrolux.svg" },
  { name: "General Electric", logo: "/assets/brands/general-electric.svg" },
  { name: "Indurama", logo: "/assets/brands/indurama.png" },
  { name: "TCL", logo: "/assets/brands/tcl.svg" },
  { name: "RCA", logo: "/assets/brands/rca.svg" },
  { name: "Midea", logo: "/assets/brands/midea.svg" },
];

const doubleBrands = [...brands, ...brands];
---

<section class="py-10 sm:py-12 bg-white dark:bg-slate-950 border-y border-slate-200 dark:border-slate-800 overflow-hidden relative select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6 sm:mb-8 text-center">
    <span class="text-xs font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1.5">
      Mantenimiento y Reparación Multimarca
    </span>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Trabajamos con las Mejores Marcas
    </h2>
    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-xl mx-auto">
      Instalamos repuestos compatibles y de alta durabilidad para garantizar el funcionamiento confiable de tus equipos.
    </p>
  </div>

  <!-- Continuous Marquee with edge fade masks -->
  <div class="relative w-full overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
    <div class="flex items-center gap-6 sm:gap-8 w-max animate-ticker hover:[animation-play-state:paused] py-2">
      {doubleBrands.map((brand) => (
        <div class="flex items-center justify-center px-6 py-3 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shrink-0 shadow-sm h-14 min-w-[130px]">
          <img
            src={brand.logo}
            alt={`Servicio técnico y repuestos para ${brand.name}`}
            class="max-h-7 max-w-[100px] object-contain opacity-85 hover:opacity-100 dark:brightness-110"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes ticker {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .animate-ticker {
    animation: ticker 32s linear infinite;
    will-change: transform;
  }
</style>
