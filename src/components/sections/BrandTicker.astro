---
// Matriz de Compatibilidad Tecnológica e Instrumental
const techPillars = [
  {
    code: "TECH // 01",
    title: "Inverter & Compresión Variable",
    description: "Diagnóstico de tarjetas electrónicas, IPM, sensores NTC y compresores DC Inverter Dual.",
    spec: "Samsung, LG, Midea, Carrier, Lennox",
  },
  {
    code: "TECH // 02",
    title: "Climatización Residencial In-Situ",
    description: "Lavado profundo con funda hermética y desagüe a balde sin tocar paredes de yeso o molduras.",
    spec: "Splits y Multisplits (12k - 36k BTU)",
  },
  {
    code: "TECH // 03",
    title: "Refrigeración No-Frost & Side-by-Side",
    description: "Desbloqueo técnico de ductos, sensores bimetal, resistencias de deshielo y termofusibles.",
    spec: "Whirlpool, Mabe, Electrolux, Indurama",
  },
  {
    code: "TECH // 04",
    title: "Manometría y Gases Ecológicos",
    description: "Carga por peso con balanza electrónica y prueba de hermeticidad con manómetros digitales.",
    spec: "Refrigerantes R410A · R32 · R600a",
  },
  {
    code: "TECH // 05",
    title: "Lavado Automático & Centrifugado",
    description: "Ajuste y cambio de varillas de suspensión, bombas de drenaje, retenes y nivelación de tina.",
    spec: "Carga Superior y Carga Frontal",
  },
  {
    code: "TECH // 06",
    title: "Cocción de Inducción & Hornos",
    description: "Revisión de módulos de potencia IGBT, bobinas magnéticas y termocuplas de seguridad.",
    spec: "Sistemas 220V y Mixtos",
  },
];

const brandList = [
  "Samsung",
  "LG",
  "Whirlpool",
  "Mabe",
  "Carrier",
  "Electrolux",
  "General Electric",
  "Indurama",
  "Midea",
  "TCL",
  "Panasonic",
  "Daikin",
];
---

<section class="py-14 bg-white dark:bg-slate-900 border-y border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Architectural Header Bar -->
    <div class="pb-6 mb-8 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
          Arquitectura Técnica y Protocolos
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Matriz de Compatibilidad Tecnológica e Instrumental
        </h2>
      </div>
      <div class="text-xs font-mono text-slate-500 dark:text-slate-400 shrink-0">
        <span>Respaldo con repuestos originales verificados</span>
      </div>
    </div>

    <!-- 6-Cell Continuous Architectural Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950/60">
      {techPillars.map((pillar) => (
        <div class="p-6 border-r border-b border-slate-200 dark:border-slate-800 flex flex-col justify-between hover:bg-white dark:hover:bg-slate-900">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-mono font-bold text-sky-600 dark:text-sky-400">
                {pillar.code}
              </span>
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            </div>

            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2 leading-snug">
              {pillar.title}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
              {pillar.description}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-200 dark:border-slate-800/80">
            <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 block mb-0.5">
              Sistemas Verificados:
            </span>
            <span class="text-xs font-mono font-semibold text-slate-700 dark:text-slate-300">
              {pillar.spec}
            </span>
          </div>
        </div>
      ))}
    </div>

    <!-- Static Typographic Brand Strip (No AI Marquee) -->
    <div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400 dark:text-slate-500 shrink-0">
        Marcas Homologadas:
      </span>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono font-semibold text-slate-600 dark:text-slate-300">
        {brandList.map((brand, idx) => (
          <span class="inline-flex items-center gap-4">
            <span class="hover:text-sky-600 dark:hover:text-sky-400 cursor-default">{brand}</span>
            {idx < brandList.length - 1 && <span class="text-slate-300 dark:text-slate-700">•</span>}
          </span>
        ))}
      </div>
    </div>

  </div>
</section>
