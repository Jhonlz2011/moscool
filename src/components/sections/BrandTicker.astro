---
const brands = [
  { name: "Samsung", logo: "/assets/brands/samsung.svg" },
  { name: "LG", logo: "/assets/brands/lg.svg" },
  { name: "Whirlpool", logo: "/assets/brands/whirlpool.svg" },
  { name: "Mabe", logo: "/assets/brands/mabe.svg" },
  { name: "Carrier", logo: "/assets/brands/carrier.svg" },
  { name: "Electrolux", logo: "/assets/brands/electrolux.svg" },
  { name: "General Electric", logo: "/assets/brands/general-electric.svg" },
  { name: "Indurama", logo: "/assets/brands/indurama.png" },
  { name: "TCL", logo: "/assets/brands/tcl.svg" },
  { name: "RCA", logo: "/assets/brands/rca.svg" },
  { name: "Midea", logo: "/assets/brands/midea.svg" },
];
---

<section class="py-12 bg-white dark:bg-slate-950 border-y border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 mb-8 border-b border-slate-200 dark:border-slate-800">
      <div>
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-1">
          Compatibilidad y Respaldo
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Marcas con Soporte Técnico y Repuestos Homologados
        </h2>
      </div>
      <div class="text-xs font-mono text-slate-500 dark:text-slate-400 shrink-0">
        <span>Climatización Inverter y Línea Blanca Residencial</span>
      </div>
    </div>

    <!-- Static Elegant Brand Logo Grid (No AI Marquee) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4">
      {brands.map((brand) => (
        <div class="h-20 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-3.5 flex items-center justify-center hover:border-slate-300 dark:hover:border-slate-700 shadow-sm">
          <img
            src={brand.logo}
            alt={`Servicio técnico para ${brand.name}`}
            class="max-h-8 max-w-[85%] object-contain opacity-85 hover:opacity-100 dark:brightness-110"
            loading="lazy"
          />
        </div>
      ))}
      
      <!-- Multi-brand Certificate Badge -->
      <div class="h-20 rounded-xl bg-sky-50/60 dark:bg-sky-950/40 border border-sky-200 dark:border-sky-800/60 p-3.5 flex flex-col justify-center text-center">
        <span class="text-[11px] font-mono font-bold text-sky-700 dark:text-sky-300 uppercase leading-tight">
          + Otras Marcas
        </span>
        <span class="text-[10px] text-slate-500 dark:text-slate-400 font-mono mt-0.5">
          Repuestos Directos
        </span>
      </div>
    </div>

  </div>
</section>
