---
import { coverageZones } from "../../data/coverage";
import { siteConfig } from "../../data/siteConfig";
import CheckIcon from "../ui/icons/CheckIcon.astro";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";
---

<section id="cobertura" class="py-20 bg-slate-100/70 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-2 font-mono">
        Rutas de Asistencia y Cobertura
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Atención Técnica Directa en tu Domicilio
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Cubrimos los tres cantones principales del Gran Guayaquil. Coordinamos con anticipación los datos requeridos para el ingreso vehicular en garitas de urbanizaciones privadas en Samborondón, Ceibos y Vía a la Costa.
      </p>
    </div>

    <!-- Garita Protocol Banner -->
    <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 mb-10 shadow-sm flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="space-y-3 max-w-2xl">
        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400 font-bold font-mono text-xs">
          <CheckIcon class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" />
          <span>Protocolo de Ingreso a Urbanizaciones y Garitas Privadas</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
          Al escribirnos por WhatsApp indicándonos tu urbanización o sector, te enviamos con anticipación los nombres completos, cédula del técnico asignado y placa del vehículo para que generes el pase en la app de tu garita (Safetec, Portería, etc.) sin demoras.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent("Hola Servicio Técnico Mendoza, deseo consultar disponibilidad y coordinar visita técnica para mi sector.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-semibold text-xs shadow-md shadow-emerald-950/20 active:translate-y-0.5 cursor-pointer"
        >
          <WhatsAppIcon class="w-4 h-4 fill-current" />
          <span>Coordinar Visita en mi Sector</span>
        </a>
      </div>
    </div>

    <!-- Expansive 3-Canton Photographic Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-7">
      {coverageZones.map((zone) => (
        <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 overflow-hidden flex flex-col justify-between hover:border-slate-300 dark:hover:border-slate-700 shadow-sm">
          <div>
            <!-- Photographic Header with subtle gradient overlay -->
            <div class="relative aspect-[16/9] w-full overflow-hidden bg-slate-900 border-b border-slate-200 dark:border-slate-800">
              <img
                src={zone.image}
                alt={`Servicio técnico a domicilio en ${zone.name}`}
                class="w-full h-full object-cover"
                loading="lazy"
                width="600"
                height="338"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/25 to-transparent"></div>
              
              <!-- Floating Arrival Time Pill -->
              <div class="absolute top-3 right-3">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-semibold bg-white/95 dark:bg-slate-900/95 text-slate-800 dark:text-slate-200 border border-slate-200/80 dark:border-slate-700/80 shadow-md backdrop-blur-sm">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  <span>{zone.estimatedTime}</span>
                </span>
              </div>

              <!-- Zone Title on Photo Base -->
              <div class="absolute bottom-3 left-4 right-4">
                <h3 class="text-xl font-extrabold text-white tracking-tight drop-shadow-sm">
                  {zone.name}
                </h3>
                <p class="text-xs text-slate-200 font-medium line-clamp-1 drop-shadow-sm mt-0.5">
                  {zone.tagline}
                </p>
              </div>
            </div>

            <!-- Sectors List -->
            <div class="p-6">
              <span class="text-[11px] font-bold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-3">
                Sectores con Cobertura:
              </span>
              <ul class="space-y-2.5 text-xs text-slate-700 dark:text-slate-300">
                {zone.sectors.map((sec) => (
                  <li class="flex items-start gap-2">
                    <CheckIcon class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400 shrink-0 mt-0.5" />
                    <span class="leading-relaxed">{sec}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Canton Specific Direct WhatsApp Action -->
          <div class="p-6 pt-0">
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
              <a
                href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hola Servicio Técnico Mendoza, me encuentro en ${zone.name} y deseo agendar una visita técnica a domicilio.`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-slate-800 dark:hover:bg-slate-700 text-white font-semibold text-xs border border-transparent shadow-sm cursor-pointer"
                aria-label={`Agendar visita técnica en ${zone.name}`}
              >
                <WhatsAppIcon class="w-3.5 h-3.5 fill-emerald-400" />
                <span>Agendar en {zone.name}</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
