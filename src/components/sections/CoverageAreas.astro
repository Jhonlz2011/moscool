---
import { coverageZones } from "../../data/coverage";
import { siteConfig } from "../../data/siteConfig";
---

<section id="cobertura" class="py-20 bg-[#0B1120] border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Info -->
      <div class="lg:col-span-5 space-y-5">
        <h2 class="text-3xl font-extrabold text-white tracking-tight">
          Zonas de Cobertura a Domicilio
        </h2>

        <p class="text-slate-300 text-sm leading-relaxed">
          Brindamos servicio técnico directo a domicilio en los tres cantones principales del Gran Guayaquil. Coordinamos la visita con puntualidad y llevamos los repuestos más comunes para resolver en la misma inspección.
        </p>

        <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300 space-y-2">
          <span class="text-emerald-400 font-semibold block">
            ✓ Atención personalizada en tu domicilio
          </span>
          <p class="text-slate-400 text-xs">
            Indícanos tu dirección y referencia al coordinar por WhatsApp para programar la ruta más cercana.
          </p>
        </div>

        <div>
          <a
            href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent("Hola, quisiera consultar disponibilidad para una visita técnica en mi sector.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition-colors"
          >
            <span>Consultar Disponibilidad en mi Sector</span>
          </a>
        </div>
      </div>

      <!-- Right Grid of Cantones -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-4">
        {coverageZones.map((zone) => (
          <div class="rounded-xl bg-slate-900 border border-slate-800 p-5 space-y-3">
            <div>
              <h3 class="font-bold text-white text-base tracking-tight">{zone.name}</h3>
              <span class="text-xs text-emerald-400 font-medium">Tiempo aprox: {zone.estimatedTime}</span>
            </div>

            <div class="pt-2 border-t border-slate-800">
              <span class="text-xs font-semibold text-slate-400 block mb-2">
                Sectores atendidos:
              </span>
              <ul class="space-y-1.5 text-xs text-slate-300">
                {zone.sectors.map((sec) => (
                  <li class="flex items-start gap-1.5">
                    <span class="text-sky-400">•</span>
                    <span>{sec}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
