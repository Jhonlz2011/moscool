---
import DiagnosticProformaCalculator from "../islands/DiagnosticProformaCalculator";
---

<section id="diagnostico" class="py-20 bg-slate-950 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Simulador de Consulta Técnica
      </h2>
      <p class="text-slate-400 text-sm mt-2">
        Indica el tipo de equipo y la falla observada para obtener una guía preliminar y comunicarte directamente con el técnico a domicilio.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <DiagnosticProformaCalculator client:visible />
    </div>
  </div>
</section>
