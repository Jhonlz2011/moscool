---
import DiagnosticProformaCalculator from "../islands/DiagnosticProformaCalculator";
---

<section id="diagnostico" class="py-20 bg-slate-100/70 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-2">
        Consulta Rápida en Línea
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Simulador de Diagnóstico Técnico
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm mt-2 max-w-xl mx-auto">
        Indica tu electrodoméstico y la anomalía que observas para generar una consulta directa para la visita a domicilio.
      </p>
    </div>

    <div class="max-w-5xl mx-auto">
      <DiagnosticProformaCalculator client:visible />
    </div>
  </div>
</section>
