---
const items = [
  { label: "VACÍO INDUSTRIAL", val: "< 500 Micrones Medidos" },
  { label: "REFRIGERANTES", val: "Ecológicos R410A / R32 / R600a" },
  { label: "PROFORMAS", val: "PDF Digital al Instante" },
  { label: "GARANTÍA", val: "30 a 90 Días por Escrito" },
  { label: "INSTRUMENTAL", val: "True-RMS y Manifolds Digitales" },
  { label: "TIEMPO RESPUESTA", val: "Despacho Hoy en tu Zona" },
];
---

<div class="border-y border-slate-800 bg-slate-950/70 py-4 overflow-hidden font-mono text-xs">
  <div class="max-w-7xl mx-auto px-4 flex flex-wrap items-center justify-between gap-6">
    {items.map((item) => (
      <div class="flex items-center gap-2.5">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        <span class="text-slate-400 text-[11px] uppercase">{item.label}:</span>
        <span class="text-white font-semibold">{item.val}</span>
      </div>
    ))}
  </div>
</div>
