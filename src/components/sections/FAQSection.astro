---
import { faqsData } from "../../data/faqs";
---

<section id="faqs" class="py-24 bg-[#090D16] border-t border-slate-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-medium bg-sky-500/10 text-sky-400 border border-sky-500/20 mb-3">
        RESOLUCIÓN DE DUDAS
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Preguntas Técnicas Frecuentes
      </h2>
      <p class="text-slate-400 text-sm mt-2">
        Respuestas honestas y fundamentadas en las mejores prácticas de ingeniería y refrigeración.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="space-y-4">
      {faqsData.map((faq, index) => (
        <details class="group rounded-2xl bg-slate-900/80 border border-slate-800 p-5 transition-all duration-200 open:border-sky-500/50 open:bg-slate-900">
          <summary class="flex items-center justify-between cursor-pointer list-none select-none">
            <div class="flex items-center gap-3 pr-4">
              <span class="text-xs font-mono text-sky-400 font-bold">
                0{index + 1}.
              </span>
              <h3 class="text-sm sm:text-base font-bold text-white tracking-tight group-hover:text-sky-300 transition-colors">
                {faq.question}
              </h3>
            </div>
            <div class="w-6 h-6 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center shrink-0 text-slate-300 group-hover:border-sky-500 group-hover:text-white transition-colors">
              <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M19 9l-7 7-7-7"/>
              </svg>
            </div>
          </summary>
          <div class="mt-4 pt-3 border-t border-slate-800/80 text-xs sm:text-sm text-slate-300 leading-relaxed pl-7">
            <span class="text-[10px] font-mono uppercase tracking-wider text-sky-400 font-semibold block mb-1">
              Dictamen Moscool [{faq.category}]:
            </span>
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
