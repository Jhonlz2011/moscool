---
import { faqsData } from "../../data/faqs";
---

<section id="faqs" class="py-20 bg-slate-950 border-t border-slate-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-12">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Preguntas Frecuentes
      </h2>
      <p class="text-slate-400 text-sm mt-2">
        Respuestas claras a las dudas más comunes sobre diagnósticos, garantías y visitas a domicilio.
      </p>
    </div>

    <div class="space-y-4">
      {faqsData.map((faq, index) => (
        <details class="group rounded-xl bg-slate-900 border border-slate-800 p-5 open:border-slate-700">
          <summary class="flex items-center justify-between cursor-pointer list-none select-none">
            <div class="flex items-center gap-3 pr-4">
              <span class="text-xs font-bold text-sky-400">
                0{index + 1}.
              </span>
              <h3 class="text-sm sm:text-base font-semibold text-white group-hover:text-sky-300 transition-colors">
                {faq.question}
              </h3>
            </div>
            <div class="w-6 h-6 rounded-full bg-slate-800 flex items-center justify-center shrink-0 text-slate-300 group-hover:text-white">
              <span class="text-sm font-bold group-open:rotate-45 transition-transform">+</span>
            </div>
          </summary>
          <div class="mt-3 pt-3 border-t border-slate-800 text-xs sm:text-sm text-slate-300 leading-relaxed pl-6">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
