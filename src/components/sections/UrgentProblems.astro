---
import FaultInspector from "../islands/FaultInspector";
---

<section class="py-20 bg-slate-100/70 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800" id="averias">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400 block mb-2 font-mono">
        Diagnóstico y Prevención
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Averías Frecuentes y Diagnóstico Real
      </h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base mt-2 leading-relaxed">
        Identifica la falla que presenta tu equipo para conocer la intervención honesta requerida, evitar cobros innecesarios y coordinar la revisión en Guayaquil, Samborondón o Durán.
      </p>
    </div>

    <!-- Interactive Fault Inspector Island -->
    <FaultInspector client:visible />
  </div>
</section>
