---
import { siteConfig } from "../../data/siteConfig";

const guaranteePoints = [
  {
    title: "Proforma Digital en PDF Inmediata",
    description: "Evaluamos el equipo en tu presencia y emitimos un presupuesto detallado con desglose de repuestos y mano de obra antes de realizar cualquier intervención.",
  },
  {
    title: "Garantía de 30 Días por Escrito",
    description: siteConfig.warrantyPeriod,
  },
  {
    title: "Validez de 15 Días",
    description: "El presupuesto emitido tiene una vigencia formal de 15 días para que tomes la decisión con tranquilidad y sin presiones.",
  },
  {
    title: "Atención a Domicilio Puntual",
    description: "Coordinamos la visita según tu disponibilidad en los cantones Guayaquil, Samborondón y Durán.",
  },
];
---

<section id="garantia" class="py-20 bg-[#0B1120] border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-12">
      <h2 class="text-3xl font-extrabold text-white tracking-tight">
        Respaldo y Transparencia en Cada Trabajo
      </h2>
      <p class="text-slate-400 text-sm sm:text-base mt-2">
        La tranquilidad de saber con claridad qué tiene tu equipo, cuánto cuesta la reparación y contar con respaldo formal.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {guaranteePoints.map((point, index) => (
        <div class="rounded-xl bg-slate-900 border border-slate-800 p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold text-sky-400 block mb-2">0{index + 1}.</span>
            <h3 class="text-base font-bold text-white mb-2 leading-snug">
              {point.title}
            </h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              {point.description}
            </p>
          </div>
          <div class="pt-4 mt-4 border-t border-slate-800 text-emerald-400 text-xs font-semibold flex items-center gap-1.5">
            <span>✓</span> Compromiso Formal
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
