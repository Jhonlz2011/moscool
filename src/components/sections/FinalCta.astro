---
import { siteConfig } from "../../data/siteConfig";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";
import CheckIcon from "../ui/icons/CheckIcon.astro";
---

<section class="py-16 bg-slate-100/60 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-8 sm:p-12 shadow-sm">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white tracking-tight">
        ¿Tu equipo no rinde o presenta fallas? Recupera su funcionamiento hoy
      </h2>

      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base max-w-xl mx-auto mt-3 leading-relaxed">
        Comunícate directamente con nosotros para coordinar tu visita técnica a domicilio en Guayaquil, Samborondón o Durán con diagnóstico honesto y 30 días de garantía.
      </p>

      <div class="mt-8 flex items-center justify-center">
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-semibold text-sm flex items-center justify-center gap-2.5 shadow-lg shadow-emerald-950/20 cursor-pointer"
          aria-label={`Escribir por WhatsApp a ${siteConfig.name}`}
        >
          <WhatsAppIcon class="w-4 h-4 fill-current" />
          <span>Escribir por WhatsApp ({siteConfig.phoneFormatted})</span>
        </a>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-500 dark:text-slate-400">
        <div class="flex items-center gap-1.5">
          <CheckIcon class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
          <span>30 Días de Garantía por Escrito</span>
        </div>
        <div class="flex items-center gap-1.5">
          <CheckIcon class="w-3.5 h-3.5 text-sky-600 dark:text-sky-400" />
          <span>Presupuesto Claro Previo</span>
        </div>
        <div class="flex items-center gap-1.5">
          <CheckIcon class="w-3.5 h-3.5 text-amber-600 dark:text-amber-400" />
          <span>Guayaquil • Samborondón • Durán</span>
        </div>
      </div>
    </div>
  </div>
</section>
