---
import { siteConfig } from "../../data/siteConfig";
---

<section class="py-20 relative overflow-hidden bg-tech-grid">
  {/* Background Glow */}
  <div class="absolute inset-0 bg-gradient-to-b from-sky-950/20 via-transparent to-slate-950 pointer-events-none"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-700/80 p-8 sm:p-14 text-center shadow-2xl relative overflow-hidden">
      
      {/* Decorative Badge */}
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-sky-500/10 border border-sky-500/20 text-xs font-mono text-sky-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        DESPACHO TÉCNICO INMEDIATO
      </div>

      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight max-w-2xl mx-auto">
        ¿Tu equipo no rinde o presenta fallas? <span class="text-gradient-cyan">Recupera su eficiencia hoy</span>
      </h2>

      <p class="text-slate-300 text-sm sm:text-base max-w-xl mx-auto mt-4 leading-relaxed font-normal">
        No permitas que un técnico improvisado dañe los componentes electrónicos de tu electrodoméstico. Agenda una inspección con instrumental calibrado y recibe tu proforma formal en minutos.
      </p>

      {/* Action Buttons */}
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-emerald-600 to-emerald-500 hover:from-emerald-500 hover:to-emerald-400 text-white font-bold text-sm tracking-wide shadow-xl shadow-emerald-950/40 transition-all flex items-center justify-center gap-2 group"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Escribir por WhatsApp</span>
        </a>

        <a
          href={`tel:${siteConfig.phone}`}
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white font-semibold text-sm transition-all flex items-center justify-center gap-2"
        >
          <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Llamada Telefónica Directa</span>
        </a>
      </div>

      {/* Assurance points */}
      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-center gap-6 text-xs font-mono text-slate-400">
        <span class="flex items-center gap-1.5">
          <span class="text-emerald-400 font-bold">✓</span> Garantía Escrita 30-90 Días
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-sky-400 font-bold">✓</span> Proforma Digital en PDF
        </span>
        <span class="flex items-center gap-1.5">
          <span class="text-amber-400 font-bold">✓</span> Despacho Hoy en tu Zona
        </span>
      </div>

    </div>
  </div>
</section>
