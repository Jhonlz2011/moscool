---
import { siteConfig } from "../../data/siteConfig";
---

<!-- Micro Header Ticker -->
<div class="bg-slate-950 border-b border-slate-800 text-[11px] text-slate-300 py-1.5 px-4 font-mono">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <div class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap">
      <span class="inline-flex items-center gap-1.5 text-emerald-400 font-semibold shrink-0">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        CUADRILLA ACTIVA HOY
      </span>
      <span class="hidden md:inline text-slate-600">|</span>
      <span class="hidden md:inline text-slate-400">
        Atención técnica in-situ • Certificación R410A/R32 • Proformas en PDF con validez
      </span>
    </div>

    <div class="flex items-center gap-4 shrink-0 text-slate-400">
      <a href={`tel:${siteConfig.phone}`} class="hover:text-sky-400 transition-colors flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span class="hidden sm:inline font-sans">{siteConfig.phoneFormatted}</span>
      </a>
      <span class="text-slate-700">/</span>
      <span class="text-sky-400 font-bold tracking-tight">GARANTÍA 30-90 DÍAS</span>
    </div>
  </div>
</div>

<!-- Main Sticky Nav -->
<header class="sticky top-0 z-50 glass-panel border-b border-slate-800/80 transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3.5 group">
      <div class="relative w-12 h-12 rounded-xl bg-slate-900 border border-slate-700/80 p-1 flex items-center justify-center overflow-hidden shadow-inner group-hover:border-sky-500/60 transition-colors">
        <img
          src="/brand/logo.png"
          alt="Logotipo de Moscool Servicio Técnico"
          class="w-full h-full object-contain"
          width="48"
          height="48"
          loading="eager"
        />
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-xl tracking-tight text-white group-hover:text-sky-300 transition-colors">
            MOSCOOL
          </span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-sky-500/20 text-sky-400 border border-sky-500/30 font-semibold">
            PRO
          </span>
        </div>
        <p class="text-[11px] font-mono text-slate-400 tracking-tight leading-none mt-0.5">
          SERVICIO TÉCNICO ESPECIALIZADO
        </p>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-7 text-xs font-medium uppercase tracking-wider text-slate-300">
      <a href="#servicios" class="hover:text-sky-400 transition-colors">Servicios</a>
      <a href="#diagnostico" class="hover:text-sky-400 transition-colors flex items-center gap-1 text-sky-400">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        Simulador
      </a>
      <a href="#estandar" class="hover:text-sky-400 transition-colors">Estándar Moscool</a>
      <a href="#proformas" class="hover:text-sky-400 transition-colors">Proformas PDF</a>
      <a href="#cobertura" class="hover:text-sky-400 transition-colors">Zonas</a>
      <a href="#faqs" class="hover:text-sky-400 transition-colors">Preguntas</a>
    </nav>

    <!-- CTAs -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={`tel:${siteConfig.phone}`}
        class="px-4 py-2.5 rounded-xl border border-slate-700 hover:border-slate-500 text-xs font-semibold text-slate-200 hover:text-white transition-all bg-slate-900/60"
      >
        Llamar
      </a>
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-sky-600 to-sky-500 hover:from-sky-500 hover:to-sky-400 text-white text-xs font-bold tracking-wide shadow-md shadow-sky-600/20 transition-all transform active:scale-95"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        <span>Agendar Visita</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="lg:hidden p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-300 hover:text-white"
      aria-label="Abrir menú de navegación"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-slate-950/95 px-5 py-4 space-y-3 font-mono text-xs">
    <a href="#servicios" class="block py-2 text-slate-300 hover:text-sky-400">01. Servicios Técnicos</a>
    <a href="#diagnostico" class="block py-2 text-sky-400 font-semibold">02. Simulador de Diagnóstico</a>
    <a href="#estandar" class="block py-2 text-slate-300 hover:text-sky-400">03. Estándar Moscool</a>
    <a href="#proformas" class="block py-2 text-slate-300 hover:text-sky-400">04. Proformas Digitales en PDF</a>
    <a href="#cobertura" class="block py-2 text-slate-300 hover:text-sky-400">05. Zonas de Cobertura</a>
    <a href="#faqs" class="block py-2 text-slate-300 hover:text-sky-400">06. Preguntas Frecuentes</a>
    <div class="pt-3 border-t border-slate-800 flex gap-3">
      <a href={`tel:${siteConfig.phone}`} class="flex-1 text-center py-2.5 rounded-lg bg-slate-900 border border-slate-700 text-white font-sans font-semibold text-xs">
        Llamar
      </a>
      <a href={`https://wa.me/${siteConfig.whatsappNumber}`} class="flex-1 text-center py-2.5 rounded-lg bg-emerald-600 text-white font-sans font-semibold text-xs">
        WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
    // Close on link click
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.add("hidden");
      });
    });
  }
</script>
