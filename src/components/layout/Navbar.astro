---
import { siteConfig } from "../../data/siteConfig";
import BrandWordmark from "../ui/BrandWordmark.astro";
import WhatsAppIcon from "../ui/icons/WhatsAppIcon.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
---

<header class="sticky top-0 z-50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 ">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo & Official Typographic SVG -->
    <a href="/" class="flex items-center gap-3 sm:gap-3.5 group select-none" aria-label="Servicio Técnico Mendoza - Inicio">
      <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-white p-1 flex items-center justify-center overflow-hidden shadow-sm shrink-0 border border-slate-200 dark:border-slate-700/60 group-hover:border-sky-500/60 ">
        <img
          src="/brand/logo.png"
          alt="Isotipo Servicio Técnico Mendoza"
          class="w-full h-full object-contain"
          width="56"
          height="56"
          loading="eager"
        />
      </div>
      <div class="flex flex-col justify-center">
        <BrandWordmark class="h-11 sm:h-13 md:h-14 w-auto" />
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="#averias" data-nav-target="averias" class="nav-item hover:text-slate-900 dark:hover:text-white py-2">Averías</a>
      <a href="#servicios" data-nav-target="servicios" class="nav-item hover:text-slate-900 dark:hover:text-white py-2">Servicios</a>
      <a href="#confianza" data-nav-target="confianza" class="nav-item hover:text-slate-900 dark:hover:text-white py-2">Por Qué Confiar</a>
      <a href="#diagnostico" data-nav-target="diagnostico" class="nav-item hover:text-slate-900 dark:hover:text-white py-2">Simulador</a>
      <a href="#cobertura" data-nav-target="cobertura" class="nav-item hover:text-slate-900 dark:hover:text-white py-2">Cobertura</a>
      <a href="#faqs" data-nav-target="faqs" class="nav-item hover:text-slate-900 dark:hover:text-white py-2">Preguntas</a>
    </nav>

    <!-- Direct Action & Theme Toggle (Desktop) -->
    <div class="hidden sm:flex items-center gap-3">
      <!-- Theme Toggle Button -->
      <ThemeToggle id="theme-toggle-desktop" class="shrink-0" />

      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white text-xs font-semibold shadow-md shadow-emerald-950/20 active:translate-y-0.5 cursor-pointer"
        aria-label="Contactar por WhatsApp"
      >
        <WhatsAppIcon class="w-3.5 h-3.5 fill-current" />
        <span>WhatsApp</span>
      </a>
    </div>

    <!-- Mobile Action Buttons (Theme Toggle + Hamburger) -->
    <div class="flex items-center gap-2 sm:hidden">
      <ThemeToggle id="theme-toggle-mobile" class="shrink-0" />

      <!-- Mobile Menu Button with Dual State Icons (Hamburger / X) -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700  cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <!-- Hamburger Icon -->
        <svg id="hamburger-icon" class="w-6 h-6 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close (X) Icon -->
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu Button for Tablet Screens (sm to lg) -->
    <div class="hidden sm:flex lg:hidden items-center">
      <button
        type="button"
        id="mobile-menu-btn-tablet"
        class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/90 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700  cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Collapsible Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-5 py-5 space-y-3.5 shadow-2xl "
  >
    <a href="#averias" data-mobile-nav-target="averias" class="mobile-nav-link block py-2.5 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 font-medium text-sm border-b border-slate-100 dark:border-slate-800/60">
      Averías Urgentes
    </a>
    <a href="#servicios" data-mobile-nav-target="servicios" class="mobile-nav-link block py-2.5 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 font-medium text-sm border-b border-slate-100 dark:border-slate-800/60">
      Servicios de Taller
    </a>
    <a href="#confianza" data-mobile-nav-target="confianza" class="mobile-nav-link block py-2.5 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 font-medium text-sm border-b border-slate-100 dark:border-slate-800/60">
      Por Qué Confiar en Nosotros
    </a>
    <a href="#diagnostico" data-mobile-nav-target="diagnostico" class="mobile-nav-link block py-2.5 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 font-medium text-sm border-b border-slate-100 dark:border-slate-800/60">
      Simulador de Consulta
    </a>
    <a href="#cobertura" data-mobile-nav-target="cobertura" class="mobile-nav-link block py-2.5 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 font-medium text-sm border-b border-slate-100 dark:border-slate-800/60">
      Zonas de Cobertura
    </a>
    <a href="#faqs" data-mobile-nav-target="faqs" class="mobile-nav-link block py-2.5 text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 font-medium text-sm">
      Preguntas Frecuentes
    </a>

    <!-- Mobile Direct CTA -->
    <div class="pt-3 border-t border-slate-200 dark:border-slate-800">
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(siteConfig.whatsappMessageDefault)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold flex items-center justify-center gap-2 active:bg-emerald-700 shadow-md cursor-pointer"
        aria-label="Contactar por WhatsApp"
      >
        <WhatsAppIcon class="w-4 h-4 fill-current" />
        <span>Escribir por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupNavbar() {
    const btn = document.getElementById("mobile-menu-btn");
    const tabletBtn = document.getElementById("mobile-menu-btn-tablet");
    const menu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");

    if (!menu) return;

    function openMenu() {
      if (!menu) return;
      menu.classList.remove("hidden");
      if (hamburgerIcon && closeIcon) {
        hamburgerIcon.classList.add("hidden");
        hamburgerIcon.classList.remove("block");
        closeIcon.classList.remove("hidden");
        closeIcon.classList.add("block");
      }
      if (btn) {
        btn.setAttribute("aria-expanded", "true");
        btn.setAttribute("aria-label", "Cerrar menú de navegación");
      }
      if (tabletBtn) {
        tabletBtn.setAttribute("aria-expanded", "true");
        tabletBtn.setAttribute("aria-label", "Cerrar menú de navegación");
      }
    }

    function closeMenu() {
      if (!menu) return;
      menu.classList.add("hidden");
      if (hamburgerIcon && closeIcon) {
        hamburgerIcon.classList.remove("hidden");
        hamburgerIcon.classList.add("block");
        closeIcon.classList.add("hidden");
        closeIcon.classList.remove("block");
      }
      if (btn) {
        btn.setAttribute("aria-expanded", "false");
        btn.setAttribute("aria-label", "Abrir menú de navegación");
      }
      if (tabletBtn) {
        tabletBtn.setAttribute("aria-expanded", "false");
        tabletBtn.setAttribute("aria-label", "Abrir menú de navegación");
      }
    }

    function toggleMenu() {
      if (!menu) return;
      const isHidden = menu.classList.contains("hidden");
      if (isHidden) {
        openMenu();
      } else {
        closeMenu();
      }
    }

    if (btn) {
      btn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu();
      };
    }

    if (tabletBtn) {
      tabletBtn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu();
      };
    }

    // Close when clicking any mobile nav link
    const mobileLinks = menu.querySelectorAll(".mobile-nav-link");
    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });

    // Close when pressing Escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !menu.classList.contains("hidden")) {
        closeMenu();
      }
    });

    // Close when clicking outside of the header
    document.addEventListener("click", (e) => {
      const header = menu.closest("header");
      if (header && !header.contains(e.target as Node) && !menu.classList.contains("hidden")) {
        closeMenu();
      }
    });

    // Dynamic Scroll-Spy: Highlights the section currently in view
    const desktopLinks = document.querySelectorAll<HTMLAnchorElement>("a[data-nav-target]");
    const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>("a[data-mobile-nav-target]");
    const sectionIds = ["averias", "servicios", "confianza", "diagnostico", "cobertura", "faqs"];

    function setActive(id: string | null) {
      desktopLinks.forEach((link) => {
        const target = link.getAttribute("data-nav-target");
        if (id && target === id) {
          link.classList.add("text-sky-600", "dark:text-sky-400", "font-bold");
          link.classList.remove("text-slate-600", "dark:text-slate-300");
        } else {
          link.classList.remove("text-sky-600", "dark:text-sky-400", "font-bold");
          link.classList.add("text-slate-600", "dark:text-slate-300");
        }
      });
      mobileNavLinks.forEach((link) => {
        const target = link.getAttribute("data-mobile-nav-target");
        if (id && target === id) {
          link.classList.add("text-sky-600", "dark:text-sky-400", "font-bold");
        } else {
          link.classList.remove("text-sky-600", "dark:text-sky-400", "font-bold");
        }
      });
    }

    const sections = sectionIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const observer = new IntersectionObserver(
      (entries) => {
        const intersecting = entries.filter((e) => e.isIntersecting);
        if (intersecting.length > 0) {
          const activeSec = intersecting[0];
          setActive(activeSec.target.id);
        }
      },
      {
        rootMargin: "-25% 0px -65% 0px",
        threshold: [0, 0.25],
      }
    );

    sections.forEach((sec) => observer.observe(sec));

    window.addEventListener(
      "scroll",
      () => {
        if (window.scrollY < 120) {
          setActive(null);
        }
      },
      { passive: true }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavbar);
  } else {
    setupNavbar();
  }
  document.addEventListener("astro:page-load", setupNavbar);
</script>
