---
import { siteConfig } from "../../data/siteConfig";
import { servicesData } from "../../data/services";
import { coverageZones } from "../../data/coverage";
---

<footer class="bg-slate-950 border-t border-slate-800/80 pt-16 pb-24 md:pb-12 text-slate-400 text-xs">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand & NAP -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-slate-900 border border-slate-700 p-1 flex items-center justify-center">
            <img src="/brand/logo.png" alt="Moscool" class="w-full h-full object-contain" width="40" height="40" />
          </div>
          <div>
            <span class="font-extrabold text-lg text-white tracking-tight">MOSCOOL</span>
            <p class="text-[10px] font-mono text-slate-500 uppercase">{siteConfig.legalName}</p>
          </div>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          {siteConfig.description}
        </p>

        <div class="space-y-1.5 pt-2 text-[11px] font-mono">
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-sky-400">Dirección:</span>
            <span>{siteConfig.address.street}, {siteConfig.address.city}</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-sky-400">Atención:</span>
            <span>Lunes a Sábado 7:30 AM - 6:30 PM | Guardia 24/7</span>
          </div>
          <div class="flex items-center gap-2 text-slate-300">
            <span class="text-sky-400">Contacto:</span>
            <a href={`tel:${siteConfig.phone}`} class="hover:text-white underline">{siteConfig.phoneFormatted}</a>
          </div>
        </div>
      </div>

      <!-- Col 2: Services -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-white font-semibold mb-4">
          Servicios Especializados
        </h4>
        <ul class="space-y-2.5">
          {servicesData.slice(0, 5).map((s) => (
            <li>
              <a href="#servicios" class="hover:text-sky-400 transition-colors line-clamp-1">
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Coverage -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-white font-semibold mb-4">
          Zonas de Cobertura
        </h4>
        <ul class="space-y-2.5">
          {coverageZones.map((z) => (
            <li>
              <a href="#cobertura" class="hover:text-sky-400 transition-colors">
                <span class="text-slate-300 font-medium">{z.name}</span>
                <span class="block text-[10px] text-slate-500 font-mono">Respuesta: {z.avgResponseHours}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Assurance -->
      <div>
        <h4 class="font-mono text-xs uppercase tracking-wider text-white font-semibold mb-4">
          Garantía y Protocolos
        </h4>
        <div class="space-y-3">
          <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-[11px]">
            <span class="text-emerald-400 font-semibold block mb-0.5">✓ 30 a 90 Días por Escrito</span>
            <p class="text-slate-400 text-[10px]">
              Garantía formal en mano de obra y repuestos homologados.
            </p>
          </div>
          <div class="p-3 rounded-xl bg-slate-900 border border-slate-800 text-[11px]">
            <span class="text-sky-400 font-semibold block mb-0.5">📄 Proforma Digital en PDF</span>
            <p class="text-slate-400 text-[10px]">
              Emitida al momento de la inspección con nuestra app móvil.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Credits -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-mono text-slate-500">
      <p>© {new Date().getFullYear()} Moscool. Todos los derechos reservados. Desarrollado con precisión técnica.</p>
      <div class="flex items-center gap-4">
        <a href="#faqs" class="hover:text-slate-400">Preguntas Frecuentes</a>
        <span>•</span>
        <a href="#diagnostico" class="hover:text-slate-400">Simulador Web</a>
        <span>•</span>
        <a href="#estandar" class="hover:text-slate-400">Estándar de Calidad</a>
      </div>
    </div>
  </div>
</footer>
