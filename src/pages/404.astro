---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout title="404 - Circuito No Encontrado | Moscool">
  <Navbar />
  <main class="min-h-[70vh] flex items-center justify-center py-20 px-4 bg-tech-grid text-center">
    <div class="max-w-lg mx-auto p-8 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-mono font-bold bg-red-500/10 text-red-400 border border-red-500/20 mb-4">
        ERROR DE COMUNICACIÓN [CÓDIGO: 404]
      </div>
      <h1 class="text-4xl font-black text-white tracking-tight mb-3">
        Circuito Desconectado
      </h1>
      <p class="text-sm text-slate-400 leading-relaxed mb-6 font-mono">
        La ruta solicitada no responde o ha sido reconfigurada. Regresa a la central técnica para continuar navegando.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition-all shadow-md shadow-sky-950"
      >
        <span>Volver a la Central Principal</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
