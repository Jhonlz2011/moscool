---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout title="Página No Encontrada | Servicio Técnico Mendoza">
  <Navbar />
  <main class="min-h-[60vh] flex items-center justify-center py-20 px-4 text-center">
    <div class="max-w-md mx-auto p-8 rounded-2xl bg-slate-900 border border-slate-800 shadow-xl">
      <span class="text-xs font-bold text-sky-400 block mb-2">ERROR 404</span>
      <h1 class="text-2xl font-bold text-white tracking-tight mb-2">
        Página no encontrada
      </h1>
      <p class="text-xs text-slate-400 leading-relaxed mb-6">
        La dirección solicitada no existe o fue modificada. Regresa al inicio para continuar navegando.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition-colors"
      >
        <span>Volver a la Página Principal</span>
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
