---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingWhatsApp from "../components/ui/FloatingWhatsApp.astro";
import Hero from "../components/sections/Hero.astro";
import BrandTicker from "../components/sections/BrandTicker.astro";
import UrgentProblems from "../components/sections/UrgentProblems.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import WhyTrustUs from "../components/sections/WhyTrustUs.astro";
import DiagnosticSection from "../components/sections/DiagnosticSection.astro";
import CoverageAreas from "../components/sections/CoverageAreas.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { siteConfig } from "../data/siteConfig";
---

<BaseLayout
  title={`${siteConfig.name} | Climatización y Línea Blanca a Domicilio en Guayaquil, Samborondón y Durán`}
  description={siteConfig.description}
>
  <Navbar />
  <main>
    <Hero />
    <BrandTicker />
    <UrgentProblems />
    <ServicesGrid />
    <WhyTrustUs />
    <DiagnosticSection />
    <CoverageAreas />
    <FAQSection />
    <FinalCta />
  </main>
  <Footer />
  <FloatingWhatsApp />
</BaseLayout>
