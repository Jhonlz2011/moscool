---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import FloatingEmergencyBar from "../components/layout/FloatingEmergencyBar.astro";
import Hero from "../components/sections/Hero.astro";
import LiveTelemetryTicker from "../components/sections/LiveTelemetryTicker.astro";
import ServicesBento from "../components/sections/ServicesBento.astro";
import DiagnosticSection from "../components/sections/DiagnosticSection.astro";
import WhyMoscoolComparison from "../components/sections/WhyMoscoolComparison.astro";
import ProformaAppSpotlight from "../components/sections/ProformaAppSpotlight.astro";
import WorkflowSteps from "../components/sections/WorkflowSteps.astro";
import CoverageAreas from "../components/sections/CoverageAreas.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import { siteConfig } from "../data/siteConfig";
---

<BaseLayout
  title={`${siteConfig.name} | Servicio Técnico Especializado en Climatización y Línea Blanca`}
  description={siteConfig.description}
>
  <Navbar />
  <main>
    <Hero />
    <LiveTelemetryTicker />
    <ServicesBento />
    <DiagnosticSection />
    <WhyMoscoolComparison />
    <ProformaAppSpotlight />
    <WorkflowSteps />
    <CoverageAreas />
    <FAQSection />
    <FinalCta />
  </main>
  <Footer />
  <FloatingEmergencyBar />
</BaseLayout>
